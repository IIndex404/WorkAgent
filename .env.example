# 复制为 .env 后填写。不要提交真实密钥。
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=

# 默认使用 compose.yml 中的本地 BGE 服务，不需要硅基流动密钥。
EMBEDDING_PROVIDER=tei
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BASE_URL=http://embedding/v1
EMBEDDING_API_KEY=
EMBEDDING_DIM=512
USE_HYBRID=1
USE_RERANK=0
RERANK_MODEL=
RERANK_BASE_URL=

# 请填字母和数字组成的数据库密码。
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

LOG_LEVEL=INFO
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=workagent
